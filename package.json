{
  "name": "@france-ioi/react-task-lib",
  "version": "4.0.0-alpha.0",
  "description": "Library to create France IOI tasks with React.js",
  "author": "SebastienTainon",
  "license": "MIT",
  "repository": "https://github.com/France-ioi/react-task-lib",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./polyfills": {
      "types": "./dist/types/polyfills/index.d.ts",
      "import": "./dist/polyfills.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./style.css": "./dist/style.css",
    "./task-env": {
      "types": "./task-env.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "task-env.d.ts"
  ],
  "sideEffects": [
    "./dist/polyfills.js",
    "*.css"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "browserslist": [
    "safari >= 10.1",
    "ios_saf >= 10.3",
    "chrome >= 55",
    "firefox >= 52",
    "edge >= 15"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:lib && pnpm run build:preset && pnpm run build:types",
    "build:lib": "vite build",
    "build:preset": "tsc -p tsconfig.preset.json",
    "build:types": "tsc -p tsconfig.types.json && node -e \"require('fs').writeFileSync('dist/types/polyfills/index.d.ts', '/** Side-effect module: polyfills for the supported browsers. */\\\\nexport {};\\\\n')\"",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint . && stylelint \"src/**/*.scss\" \"playground/src/**/*.scss\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "gen:polyfills": "node scripts/generate-polyfills.mjs",
    "check:compat": "node scripts/check-compat.mjs",
    "playground:build": "pnpm --filter playground build",
    "playground:dev": "pnpm --filter playground dev",
    "ci": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run playground:build && pnpm run check:compat && pnpm run test:e2e",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "vite": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "autoprefixer": "^10.6.2",
    "core-js": "^3.51.0",
    "terser": "^5.51.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "packageManager": "pnpm@10.10.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.6",
    "@hedgedoc/html-to-react": "^1.4.6",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "acorn": "^8.19.0",
    "core-js-compat": "^3.51.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "i18next": "^25.10.10",
    "immer": "^10.2.0",
    "jsdom": "^30.1.3",
    "json-stable-stringify-without-jsonify": "^1.0.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "query-string": "^9.5.1",
    "range": "0.0.3",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-i18next": "^15.7.4",
    "react-redux": "^9.3.1",
    "redux": "^5.0.1",
    "redux-saga": "^1.5.1",
    "sass": "^1.107.1",
    "stylelint": "^17.16.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typed-redux-saga": "^1.5.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "url-search-params-polyfill": "^8.2.5",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
